# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Postgres / Supabase)
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/postgres

# Supabase storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=

# Auth (better-auth)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Contact form (Resend)
RESEND_API_KEY=
SUPPORT_EMAIL=you@example.com

# Reviews (Vouchley)
VOUCHLEY_API_KEY=
# Comma separated review ids shown first
VOUCHLEY_PINNED_REVIEWS=

# Analytics (PostHog)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# AI (OpenRouter), used for translations and the chatbot
OPENROUTER_API_KEY=

# Chatbot rate limits (Upstash Redis). Required in production, otherwise the chatbot is hidden
REDIS_KV_REST_API_URL=
REDIS_KV_REST_API_TOKEN=

# Optional, messages per day
CHAT_USER_DAILY_LIMIT=30
CHAT_GLOBAL_DAILY_LIMIT=100

# Optional, falls back to keyword search
VECTOR_UPSTASH_VECTOR_REST_URL=
VECTOR_UPSTASH_VECTOR_REST_TOKEN=
